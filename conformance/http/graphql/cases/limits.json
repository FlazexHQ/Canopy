              "content-type": "application/json; charset=utf-8",
              "x-request-id": "limits.complexity-over-limit.0"
            },
            "body": "{\"errors\":[{\"message\":\"The operation costs 11; the budget is 10\",\"extensions\":{\"code\":\"CANOPY_INVALID_QUERY\",\"details\":{\"limit\":\"complexity\",\"value\":11,\"max\":10}}}]}"
          }
        }
      ]
    },
    {
