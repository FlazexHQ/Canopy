            },
            "body": "{\"query\":\"query Page($limit: Int!) { todos(limit: $limit) { nodes { title } total } }\",\"variables\":{\"limit\":3}}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "limits.complexity-at-limit.0"
            },
            "body": "{\"data\":{\"todos\":{\"nodes\":[{\"title\":\"todo 1\"},{\"title\":\"todo 2\"},{\"title\":\"todo 3\"}],\"total\":4}}}"
          }
        }
      ]
    },
