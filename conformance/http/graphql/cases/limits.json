{
  "group": "limits",
  "description": "Operations at the limit and one unit beyond it",
  "cases": [
    {
      "id": "depth-at-limit",
      "title": "Three levels of fields fit the depth limit",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "limits.depth-at-limit.0"
            },
            "body": "{\"query\":\"{ todos(limit: 1) { nodes { title } } }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "limits.depth-at-limit.0"
            },
            "body": "{\"data\":{\"todos\":{\"nodes\":[{\"title\":\"todo 1\"}]}}}"
          }
        }
      ]
    },
    {
      "id": "depth-over-limit",
      "title": "Four levels of fields exceed the depth limit",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "limits.depth-over-limit.0"
            },
            "body": "{\"query\":\"{ todos(limit: 1) { nodes { detail { note } } } }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "limits.depth-over-limit.0"
            },
            "body": "{\"errors\":[{\"message\":\"The operation is 4 fields deep; at most 3 are allowed\",\"extensions\":{\"code\":\"CANOPY_INVALID_QUERY\",\"details\":{\"limit\":\"depth\",\"value\":4,\"max\":3}}}]}"
          }
        }
      ]
    },
