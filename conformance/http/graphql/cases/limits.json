    {
      "id": "complexity-at-limit",
      "title": "A list operation with cost ten fits the complexity budget",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
