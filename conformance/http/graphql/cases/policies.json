{
  "group": "policies",
  "description": "Caller specific schemas, document and field rules, and context lookups",
  "cases": [
    {
      "id": "other-owner",
      "title": "A document owned by another caller returns null",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "policies.other-owner.0"
            },
            "body": "{\"query\":\"{ todo(id: \\\"600000000000000000000005\\\") { title } todosCount }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "policies.other-owner.0"
            },
            "body": "{\"data\":{\"todo\":null,\"todosCount\":4}}"
          }
        }
      ]
    },
    {
      "id": "restrictive-read",
      "title": "A restrictive policy excludes archived staff",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "policies.restrictive-read.0"
            },
            "body": "{\"query\":\"{ staff(sort: [{ field: _id }], limit: 2) { nodes { name } total } }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "policies.restrictive-read.0"
            },
            "body": "{\"data\":{\"staff\":{\"nodes\":[{\"name\":\"Ada\"},{\"name\":\"Brook\"}],\"total\":5}}}"
          }
        }
      ]
    },
    {
      "id": "field-hidden",
