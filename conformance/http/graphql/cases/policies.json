    {
      "id": "missing-key",
      "title": "A request without a key is rejected",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "none",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "policies.missing-key.0"
            },
            "body": "{\"query\":\"{ __typename }\"}"
          },
          "response": {
            "status": 401,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "policies.missing-key.0"
            },
            "body": "{\"errors\":[{\"message\":\"Unknown API key\",\"extensions\":{\"code\":\"CANOPY_UNAUTHORIZED\",\"hint\":\"Send an API key in the apikey header, and a signed in user's token as Authorization: Bearer <token>.\",\"docs\":\"errors/unauthorized\"}}]}"
          }
        }
      ]
    },
