          }
        }
      ]
    },
    {
      "id": "context-lookup",
      "title": "Memberships scope tasks differently for Alice and Bob",
      "steps": [
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "alice",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "policies.context-lookup.0"
            },
            "body": "{\"query\":\"{ tasks(sort: [{ field: _id }], limit: 3) { nodes { title } total } }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "policies.context-lookup.0"
            },
            "body": "{\"data\":{\"tasks\":{\"nodes\":[{\"title\":\"task 1\"},{\"title\":\"task 2\"},{\"title\":\"task 3\"}],\"total\":4}}}"
          }
        },
        {
          "request": {
            "method": "POST",
            "target": "/graphql/v1",
            "query": [],
            "caller": "bob",
            "headers": {
              "content-type": "application/json",
              "x-request-id": "policies.context-lookup.1"
            },
            "body": "{\"query\":\"{ tasks(sort: [{ field: _id }], limit: 3) { nodes { title } total } }\"}"
          },
          "response": {
            "status": 200,
            "headers": {
              "content-type": "application/json; charset=utf-8",
              "x-request-id": "policies.context-lookup.1"
            },
            "body": "{\"data\":{\"tasks\":{\"nodes\":[{\"title\":\"task 3\"},{\"title\":\"task 4\"}],\"total\":2}}}"
          }
        }
      ]
    },
    {
