    {
      "id": "count-own",
      "title": "An owner counts only the documents the owner policy admits",
      "request": {
        "method": "POST",
        "target": "/rest/v1/todos/_count",
        "query": [],
        "caller": "alice",
        "headers": {
          "content-type": "application/json",
          "x-request-id": "count.count-own"
        },
        "body": "{}"
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "x-request-id": "count.count-own"
        },
        "body": "{\"data\":{\"count\":8,\"exact\":true},\"ct\":\"<ct>\"}",
        "volatile": [
          {
            "rule": "cluster-time",
            "body": "$.ct"
          }
        ],
        "neverInBody": []
      }
    },
