{
  "name": "@canopy/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark workloads, committed baselines and spike prototypes for the Canopy data plane gates.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "matcher": "node --conditions=@canopy/source workloads/matcher/throughput.ts",
    "matcher:events": "node --conditions=@canopy/source workloads/matcher/event-cost.ts",
    "matcher:check": "node ../packages/testing/scripts/bench-gate.ts --baseline baselines/matcher/baseline.json",
    "matcher:events:check": "node ../packages/testing/scripts/bench-gate.ts --baseline baselines/matcher/event-baseline.json",
    "realtime": "node --conditions=@canopy/source workloads/realtime/fanout.ts",
    "realtime:check": "node ../packages/testing/scripts/bench-gate.ts --baseline baselines/realtime/baseline.json",
    "realtime:compare": "node workloads/realtime/compare.ts",
    "rest": "node --conditions=@canopy/source workloads/rest/write-cost.ts",
    "rest:scale": "node --conditions=@canopy/source workloads/rest/scale.ts",
    "rest:compare": "node --conditions=@canopy/source workloads/rest/compare.ts",
    "rest:profile-top": "node workloads/rest/profile-top.ts",
    "rest:check": "node workloads/rest/check.ts",
    "d0": "node --conditions=@canopy/source workloads/d0/run.ts",
    "d1": "node --conditions=@canopy/source workloads/d1/find.ts",
    "d2": "node --conditions=@canopy/source workloads/d2/writes.ts",
    "d3": "node --conditions=@canopy/source workloads/d3/graphql.ts",
    "d4": "node --conditions=@canopy/source workloads/d4/storage.ts",
    "test": "vitest run",
    "wire": "node --conditions=@canopy/source workloads/wire/s13-wire.ts"
  },
  "devDependencies": {
    "@canopy/auth": "workspace:*",
    "@canopy/graphql": "workspace:*",
    "@canopy/matcher": "workspace:*",
    "@canopy/native": "workspace:*",
    "@canopy/node-http": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/protocol": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/rest": "workspace:*",
    "@canopy/server": "workspace:*",
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "bson": "catalog:",
    "canopy.js": "0.0.0",
    "jose": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
