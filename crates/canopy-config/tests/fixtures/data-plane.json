{
  "mongodb": {
    "uri": "mongodb://db.example.test/app",
    "database": "app",
    "metaDatabase": "canopy"
  },
  "server": {
    "port": 8080,
    "metricsPort": 9464,
    "metricsHost": "127.0.0.1",
    "nodeId": "n1",
    "trustedProxies": []
  },
  "auth": null,
  "keys": {
    "publishable": [],
    "secret": []
  },
  "policies": {
    "source": "database",
    "watch": true
  },
  "realtime": {
    "fullDocument": "auto",
    "checkpoints": "meta",
    "resumeWindowMs": 120000,
    "drainWindowMs": 30000,
    "transports": ["websocket", "sse", "long-poll"]
  },
  "rateLimits": {
    "messages": {
      "perSecond": 20,
      "burst": 100
    },
    "requests": {
      "perSecond": 50,
      "burst": 200
    },
    "failedAuthentications": {
      "perSecond": 1,
      "burst": 30
    },
    "anonymousConnectionsPerAddress": 50,
    "exemptService": true
  },
  "rest": {
    "defaultLimit": 25,
    "maxLimit": 250,
    "maxBodyBytes": 4096,
    "search": ["articles"],
    "idTypes": {
      "counters": "number"
    },
    "mutationTtlSeconds": 86400,
    "explainDenials": true
  },
  "graphql": {
    "path": "/graphql/v1",
    "maxDepth": 4,
    "maxComplexity": 500,
    "maxAliases": 12,
    "maxBatch": 3,
    "introspection": "authenticated",
    "collections": {
      "articles": {
        "typeName": "Story",
        "relations": {
          "notes": {
            "to": "notes",
            "local": "_id",
            "foreign": "articleId",
            "many": true
          }
        }
      }
    },
    "persisted": {
      "operations": {
        "9b15636826a31db36e8b145188fb218e83cbd26047bd6cb851c018cbfb91c87b": "{ todosCount }"
      },
      "only": true
    }
  },
  "dataPlane": {
    "routes": ["find", "count", "distinct", "aggregate", "query", "explain", "writes", "graphql"]
  },
  "log": {
    "level": "info"
  },
  "telemetry": {
    "tracing": true
  },
  "audit": {
    "dataWrites": true
  }
}
