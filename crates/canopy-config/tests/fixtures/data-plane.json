{
  "mongodb": {
    "uri": "mongodb://db.example.test/app",
    "database": "app",
    "metaDatabase": "canopy"
  },
  "server": {
    "port": 8080,
    "metricsPort": 9464,
    "metricsHost": "127.0.0.1",
    "nodeId": "n1",
    "trustedProxies": []
  },
  "auth": null,
  "keys": {
    "publishable": [],
    "secret": []
  },
  "policies": {
    "source": "database",
    "watch": true
  },
  "realtime": {
    "fullDocument": "auto",
    "checkpoints": "meta",
    "resumeWindowMs": 120000,
    "drainWindowMs": 30000,
    "transports": ["websocket", "sse", "long-poll"]
  },
  "rateLimits": {
    "messages": {
      "perSecond": 20,
      "burst": 100
    },
    "anonymousConnectionsPerAddress": 50,
    "exemptService": true
  },
  "rest": {
    "defaultLimit": 25,
    "maxLimit": 250,
    "maxBodyBytes": 4096,
    "search": ["articles"]
  },
  "log": {
    "level": "info"
  },
  "dataPlane": {
    "routes": ["find", "count", "distinct", "aggregate"]
  }
}
