{
  "mongodb": {
    "uri": "mongodb://db.example.test/app",
    "database": "app",
    "metaDatabase": "canopy"
  },
  "server": {
    "port": 8080,
    "metricsPort": 9464,
    "metricsHost": "127.0.0.1",
    "nodeId": "n1",
    "trustedProxies": []
  },
  "auth": null,
  "keys": {
    "publishable": [],
    "secret": []
  },
  "policies": {
    "source": "database",
    "watch": true
  },
  "realtime": {
    "fullDocument": "auto",
    "checkpoints": "meta",
    "resumeWindowMs": 120000,
    "drainWindowMs": 30000,
    "transports": ["websocket", "sse", "long-poll"]
  },
  "rateLimits": {
    "messages": {
      "perSecond": 20,
      "burst": 100
    },
    "requests": {
      "perSecond": 50,
      "burst": 200
    },
    "failedAuthentications": {
      "perSecond": 1,
      "burst": 30
    },
    "anonymousConnectionsPerAddress": 50,
    "exemptService": true
  },
  "rest": {
    "defaultLimit": 25,
    "maxLimit": 250,
    "maxBodyBytes": 4096,
    "search": ["articles"],
    "idTypes": {
      "counters": "number"
    },
    "mutationTtlSeconds": 86400,
    "explainDenials": true
  },
  "graphql": {
    "path": "/graphql/v1",
    "maxDepth": 4,
    "maxComplexity": 500,
    "maxAliases": 12,
    "maxBatch": 3,
    "introspection": "authenticated",
    "collections": {
      "articles": {
        "typeName": "Story",
        "relations": {
          "notes": {
            "to": "notes",
            "local": "_id",
            "foreign": "articleId",
            "many": true
          }
        }
      }
    },
    "persisted": {
      "operations": {
        "9b15636826a31db36e8b145188fb218e83cbd26047bd6cb851c018cbfb91c87b": "{ todosCount }"
      },
      "only": true
    }
  },
  "wire": {
    "port": 27018,
    "host": "127.0.0.1",
    "maxMessageBytes": 16000000,
    "maxConnections": 32,
    "idleTimeoutMs": 10000,
    "tls": { "certFile": "wire-cert.pem", "keyFile": "wire-key.pem" }
  },
  "dataPlane": {
    "routes": [
      "find",
      "count",
      "distinct",
      "aggregate",
      "query",
      "explain",
      "writes",
      "graphql",
      "storage"
    ]
  },
  "log": {
    "level": "info"
  },
  "telemetry": {
    "tracing": true
  },
  "audit": {
    "dataWrites": true
  },
  "storage": {
    "path": "/storage/v1",
    "buckets": {
      "files": {
        "public": true,
        "maxFileSize": 8192,
        "allowedTypes": ["text/plain"]
      }
    },
    "images": {
      "enabled": true,
      "maxDimension": 2500,
      "maxSourceSize": 26214400
    },
    "backend": {
      "kind": "s3",
      "endpoint": "https://s3.example.test",
      "region": "us-east-1",
      "bucket": "canopy-fixture",
      "accessKeyId": "fixture-access",
      "secretAccessKey": "fixture-secret",
      "sessionToken": "fixture-session",
      "forcePathStyle": true,
      "prefix": "fixtures/"
    },
    "signingMasterKey": "fixture-storage-master-keyfixture-storage-master-key",
    "partSize": 8388608,
    "maxUploadSize": 16777216,
    "uploadTtlMs": 86400000,
    "maxSignedUrlSeconds": 604800
  }
}
