{
  "mongodb": {
    "uri": "mongodb://db.example.test/app",
    "database": "app",
    "metaDatabase": "canopy"
  },
  "server": {
    "port": 8080,
    "metricsPort": 9464,
    "metricsHost": "127.0.0.1",
    "nodeId": "n1",
    "trustedProxies": []
  },
  "auth": null,
  "keys": {
    "publishable": [],
    "secret": []
  },
  "policies": {
    "source": "database",
    "watch": true
  },
  "realtime": {
    "fullDocument": "auto",
    "checkpoints": "meta",
    "resumeWindowMs": 120000,
    "drainWindowMs": 30000,
    "transports": ["websocket", "sse", "long-poll"]
  },
  "rateLimits": {
    "messages": {
      "perSecond": 20,
      "burst": 100
    },
    "requests": {
      "perSecond": 50,
      "burst": 200
    },
    "failedAuthentications": {
      "perSecond": 1,
      "burst": 30
    },
    "anonymousConnectionsPerAddress": 50,
    "exemptService": true
  },
  "rest": {
    "defaultLimit": 100,
    "maxLimit": 1000,
    "maxBodyBytes": 1048576,
    "search": [],
    "idTypes": {},
    "mutationTtlSeconds": 86400,
    "explainDenials": true
  },
  "graphql": {
    "path": "/graphql/v1",
    "maxDepth": 10,
    "maxComplexity": 5000,
    "maxAliases": 30,
    "maxBatch": 10,
    "introspection": "always",
    "collections": {}
  },
  "log": {
    "level": "info"
  },
  "telemetry": {
    "tracing": false
  },
  "audit": {
    "dataWrites": false
  }
}
