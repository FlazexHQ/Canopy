{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canopy data plane configuration",
  "description": "The launcher document read without environment fallbacks. Unknown fields are ignored. Optional fields of the wrong type use their defaults unless a constraint says otherwise. Values are resolved as binary64 numbers. The resolved application and meta databases must differ. MongoDB URI, policy, upstream URL and JWT verification details are checked separately on startup.",
  "type": "object",
  "required": ["mongodb"],
  "properties": {
    "mongodb": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string" },
        "database": {
          "$ref": "#/$defs/string",
          "description": "Defaults to the database in the MongoDB URI."
        },
        "metaDatabase": { "$ref": "#/$defs/string", "default": "canopy" }
      },
      "anyOf": [
        { "required": ["database"], "properties": { "database": { "type": "string" } } },
        { "properties": { "uri": { "pattern": "^(?:(?!://)[\\s\\S])*://[^/]*/[^?#]" } } }
      ]
    },
    "server": {
      "properties": {
        "host": { "$ref": "#/$defs/string", "default": "0.0.0.0" },
        "port": {
          "if": { "type": "number" },
          "then": { "exclusiveMaximum": 65536 },
          "default": 8080,
          "description": "Positive numbers are truncated. Values at or below zero select an ephemeral port."
        },
        "metricsHost": { "$ref": "#/$defs/string", "default": "127.0.0.1" },
        "metricsPort": {
          "$ref": "#/$defs/number",
          "default": 9464,
          "description": "Positive numbers are truncated. Values at or below zero or at least 65536 disable the metrics listener."
        },
        "metricsToken": { "$ref": "#/$defs/string" },
        "trustedProxies": {
          "$ref": "#/$defs/strings",
          "default": [],
          "description": "IP addresses and CIDR ranges. Invalid entries are ignored."
        },
        "nodeId": { "$ref": "#/$defs/string", "default": "n1" },
        "shards": {
          "$ref": "#/$defs/number",
          "description": "Uses a positive truncated count that fits the target platform. Otherwise uses the available parallelism clamped to 1 through 4, or 2 if unavailable."
        }
      }
    },
    "auth": {
      "default": null,
      "description": "Only an object enables JWT verification. Null explicitly disables it.",
      "if": { "type": "object" },
      "then": {
        "required": ["issuer"],
        "properties": {
          "issuer": {
            "anyOf": [{ "type": "string" }, { "type": "array", "contains": { "type": "string" } }]
          },
          "audience": { "$ref": "#/$defs/strings", "default": [] },
          "jwks": {
            "description": "Any value other than null is passed to the verifier as inline JWKS."
          },
          "jwksUrl": { "$ref": "#/$defs/string" },
          "algorithms": { "$ref": "#/$defs/strings", "default": [] },
          "rolesClaim": { "$ref": "#/$defs/string" },
          "allowServiceRoleFromJwt": { "$ref": "#/$defs/boolean", "default": false },
          "clockToleranceSeconds": { "$ref": "#/$defs/whole", "default": 60 },
          "checkRevocations": { "$ref": "#/$defs/boolean", "default": false }
        },
        "anyOf": [
          { "required": ["jwks"], "properties": { "jwks": { "not": { "type": "null" } } } },
          { "required": ["jwksUrl"], "properties": { "jwksUrl": { "type": "string" } } }
        ]
      }
    },
    "keys": {
      "properties": {
        "publishable": { "$ref": "#/$defs/strings" },
        "secret": { "$ref": "#/$defs/strings", "default": [] }
      }
    },
    "policies": {
      "description": "A stored array selects launcher supplied policies. Otherwise policies are loaded from the meta database. The launcher also emits a source field that the parser ignores.",
      "properties": {
        "stored": { "type": "array" },
        "contexts": {
          "description": "Context lookups for stored policies. Null or omission provides no lookups."
        },
        "watch": {
          "$ref": "#/$defs/boolean",
          "default": true,
          "description": "Applies to policies loaded from the database."
        },
        "source": {
          "description": "Informational launcher field. The parser selects the source by the presence of stored."
        }
      }
    },
    "realtime": {
      "properties": {
        "fullDocument": {
          "if": { "type": "string" },
          "then": { "enum": ["auto", "updateLookup", "images"] },
          "default": "auto"
        },
        "checkpoints": {
          "$ref": "#/$defs/string",
          "default": "meta",
          "description": "Only the string off disables checkpoint storage."
        },
        "resumeWindowMs": { "$ref": "#/$defs/whole", "default": 120000 },
        "drainWindowMs": { "$ref": "#/$defs/whole", "default": 30000 },
        "heartbeatMs": { "$ref": "#/$defs/whole", "default": 25000 },
        "coalesceMs": {
          "if": { "type": "number" },
          "then": { "minimum": 0, "maximum": 1000 },
          "default": 0,
          "description": "Accepted numbers are truncated to whole milliseconds."
        },
        "transports": {
          "$ref": "#/$defs/strings",
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/transport" },
          "items": { "if": { "type": "string" }, "then": { "$ref": "#/$defs/transport" } },
          "default": ["websocket", "sse", "long-poll"]
        }
      }
    },
    "cors": {
      "properties": {
        "origins": {
          "$ref": "#/$defs/strings",
          "description": "A wildcard entry allows any origin."
        }
      }
    },
    "rateLimits": {
      "description": "Only the literal false disables limits. Other values enable them with any supplied options.",
      "properties": {
        "messages": {
          "properties": {
            "perSecond": { "$ref": "#/$defs/number", "default": 20 },
            "burst": { "$ref": "#/$defs/number", "default": 100 }
          }
        },
        "requests": {
          "description": "Data API requests per caller, for the routes the gateway serves itself.",
          "properties": {
            "perSecond": { "$ref": "#/$defs/number", "default": 50 },
            "burst": { "$ref": "#/$defs/number", "default": 200 }
          }
        },
        "failedAuthentications": {
          "description": "Failed authentications per client address on the routes the gateway serves itself; an address without budget is refused before its credentials are checked.",
          "properties": {
            "perSecond": { "$ref": "#/$defs/number", "default": 1 },
            "burst": { "$ref": "#/$defs/number", "default": 30 }
          }
        },
        "anonymousConnectionsPerAddress": { "$ref": "#/$defs/whole", "default": 50 },
        "exemptService": { "$ref": "#/$defs/boolean", "default": true }
      }
    },
    "mutations": { "properties": { "url": { "$ref": "#/$defs/string" } } },
    "proxy": { "properties": { "url": { "$ref": "#/$defs/string" } } },
    "log": { "properties": { "level": { "$ref": "#/$defs/string", "default": "info" } } },
    "telemetry": {
      "properties": {
        "tracing": {
          "type": "boolean",
          "default": false,
          "description": "Records OpenTelemetry traces of the requests the gateway answers itself, their MongoDB commands and the policy loads, exported over OTLP/HTTP as the OTEL_* variables say. Replaces CANOPY_TRACING (true, false, 1 or 0)."
        }
      }
    },
    "rest": {
      "description": "The Data API settings a data plane route needs. Only the literal false disables the Data API, and then dataPlane.routes must be empty. Positive numbers are truncated. The default limit must not exceed the maximum.",
      "properties": {
        "defaultLimit": {
          "if": { "type": "number" },
          "then": { "minimum": 1 },
          "default": 100,
          "description": "Page size when the caller sets none."
        },
        "maxLimit": {
          "if": { "type": "number" },
          "then": { "minimum": 1 },
          "default": 1000,
          "description": "The largest page a caller may request."
        },
        "maxSkip": {
          "$ref": "#/$defs/whole",
          "default": 10000,
          "description": "The largest skip. Cursors have no such limit. The TypeScript launcher does not set it."
        },
        "maxBodyBytes": {
          "$ref": "#/$defs/whole",
          "default": 1048576,
          "description": "The largest request body of a data plane route, in bytes; a longer body answers 413."
        },
        "search": {
          "$ref": "#/$defs/strings",
          "default": [],
          "description": "The collections whose aggregations may start with $search or $vectorSearch (they need a MongoDB Search index)."
        },
        "idTypes": {
          "type": "object",
          "additionalProperties": { "enum": ["auto", "objectId", "uuid", "string", "number"] },
          "default": {},
          "description": "How the {id} path segment of a collection's documents is read; collections it does not name read auto (24 hexadecimal characters as an ObjectId, anything else as a string)."
        },
        "mutationTtlSeconds": {
          "$ref": "#/$defs/whole",
          "default": 86400,
          "description": "How long idempotency records of the write routes live, in seconds."
        },
        "explainDenials": {
          "type": "boolean",
          "default": false,
          "description": "Refused writes explain the policies that decided, in details.explain. It reveals the policy structure: development only."
        }
      }
    },
    "audit": {
      "properties": {
        "dataWrites": {
          "type": "boolean",
          "default": false,
          "description": "Records every committed write of the write routes in the audit log of the meta database."
        }
      }
    },
    "graphql": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^?#]*$",
              "default": "/graphql/v1"
            },
            "maxDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "maxComplexity": {
              "type": "number",
              "minimum": 1,
              "default": 5000
            },
            "maxAliases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "default": 30
            },
            "maxBatch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 10
            },
            "introspection": {
              "enum": ["always", "authenticated", "never"],
              "default": "always"
            },
            "persisted": {
              "type": "object",
              "required": ["operations"],
              "additionalProperties": false,
              "properties": {
                "operations": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "only": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "collections": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "typeName": {
                    "type": "string"
                  },
                  "relations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["to", "local"],
                      "additionalProperties": false,
                      "properties": {
                        "to": {
                          "type": "string"
                        },
                        "local": {
                          "type": "string"
                        },
                        "foreign": {
                          "type": "string"
                        },
                        "many": {
                          "type": "boolean",
                          "default": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "storage": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["buckets", "backend"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/(?!/*$)[^?#]+$",
              "default": "/storage/v1"
            },
            "buckets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["public", "maxFileSize", "allowedTypes"],
                "properties": {
                  "public": {
                    "type": "boolean"
                  },
                  "maxFileSize": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "allowedTypes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "backend": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "root"],
                  "properties": {
                    "kind": {
                      "const": "local"
                    },
                    "root": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "region", "bucket", "accessKeyId", "secretAccessKey"],
                  "properties": {
                    "kind": {
                      "const": "s3"
                    },
                    "region": {
                      "type": "string"
                    },
                    "bucket": {
                      "type": "string"
                    },
                    "accessKeyId": {
                      "type": "string",
                      "writeOnly": true
                    },
                    "secretAccessKey": {
                      "type": "string",
                      "writeOnly": true
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "sessionToken": {
                      "type": "string",
                      "writeOnly": true
                    },
                    "forcePathStyle": {
                      "type": "boolean"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "accountId", "bucket", "accessKeyId", "secretAccessKey"],
                  "properties": {
                    "kind": {
                      "const": "r2"
                    },
                    "accountId": {
                      "type": "string"
                    },
                    "bucket": {
                      "type": "string"
                    },
                    "accessKeyId": {
                      "type": "string",
                      "writeOnly": true
                    },
                    "secretAccessKey": {
                      "type": "string",
                      "writeOnly": true
                    },
                    "jurisdiction": {
                      "type": "string"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "signingMasterKey": {
              "type": "string",
              "writeOnly": true
            },
            "partSize": {
              "type": "integer",
              "minimum": 5242880,
              "default": 8388608
            },
            "maxUploadSize": {
              "type": "integer",
              "minimum": 1,
              "default": 5368709120
            },
            "uploadTtlMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 86400000
            },
            "maxSignedUrlSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 604800
            }
          }
        }
      ]
    },
    "dataPlane": {
      "properties": {
        "routes": {
          "$ref": "#/$defs/strings",
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/dataPlaneRoute" },
          "items": { "if": { "type": "string" }, "then": { "$ref": "#/$defs/dataPlaneRoute" } },
          "default": [],
          "description": "The Data API routes the gateway serves itself. find is GET /rest/v1/{collection}; count, distinct, aggregate, query and explain are POST /rest/v1/{collection}/_count, _distinct, _aggregate, _query and _explain; document is GET /rest/v1/{collection}/{id}; writes are POST, PATCH and DELETE /rest/v1/{collection}, PATCH, PUT and DELETE /rest/v1/{collection}/{id} and POST /rest/v1/_batch; graphql is GET and POST /graphql/v1 by default; storage serves /storage/v1 except image transformations. Every other request goes to the upstream server. Replaces CANOPY_DATA_PLANE_ROUTES, which takes a comma separated list."
        }
      }
    },
    "viewTokens": {
      "properties": {
        "jwk": {
          "type": "object",
          "required": ["kty", "crv", "x"],
          "properties": {
            "kty": { "const": "OKP" },
            "crv": { "const": "Ed25519" },
            "x": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]=*(?![\\s\\S])",
              "description": "A 32 byte Ed25519 public key encoded as base64url. Trailing padding is ignored."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "string": { "if": { "type": "string" }, "else": { "description": "Ignored by the parser." } },
    "number": { "if": { "type": "number" }, "else": { "description": "Ignored by the parser." } },
    "whole": {
      "$ref": "#/$defs/number",
      "description": "Positive numbers are truncated and capped at the destination's maximum. Values at or below zero resolve to zero."
    },
    "boolean": { "if": { "type": "boolean" }, "else": { "description": "Ignored by the parser." } },
    "strings": {
      "if": { "type": "string" },
      "then": { "description": "Read as a list of one string." },
      "else": {
        "if": { "type": "array" },
        "then": { "items": { "$ref": "#/$defs/string" } },
        "else": { "description": "Ignored by the parser." }
      }
    },
    "transport": { "enum": ["websocket", "sse", "long-poll"] },
    "dataPlaneRoute": {
      "enum": [
        "find",
        "count",
        "distinct",
        "aggregate",
        "query",
        "explain",
        "document",
        "writes",
        "graphql",
        "storage"
      ]
    }
  }
}
