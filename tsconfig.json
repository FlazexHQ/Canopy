{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/root.tsbuildinfo"
  },
  "include": ["*.ts"],
  "references": [
    { "path": "packages/testing" },
    { "path": "packages/protocol" },
    { "path": "packages/protocol/test" },
    { "path": "packages/matcher" },
    { "path": "packages/matcher/test" },
    { "path": "packages/query" },
    { "path": "packages/query/test" },
    { "path": "packages/policy" },
    { "path": "packages/policy/test" },
    { "path": "packages/auth" },
    { "path": "packages/auth/test" },
    { "path": "packages/realtime" },
    { "path": "packages/realtime/test" },
    { "path": "packages/rest" },
    { "path": "packages/rest/test" },
    { "path": "packages/rest/bench" },
    { "path": "packages/client" },
    { "path": "packages/client/test" },
    { "path": "packages/react" },
    { "path": "packages/react/test" },
    { "path": "packages/cli" },
    { "path": "packages/cli/test" },
    { "path": "examples/express-dropin" },
    { "path": "examples/express-dropin/web" }
  ]
}
