{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/*.tsbuildinfo",
      "!!docs",
      "!!bench/spikes",
      "!!plans",
      "!!api",
      "!!conformance/matcher",
      "!!conformance/query",
      "!!conformance/policy",
      "!!conformance/http",
      "!!conformance/http/admin",
      "!!conformance/http/studio",
      "!!conformance/http/storage",
      "!!conformance/graphql/schema.json",
      "!!conformance/cursor",
      "!!conformance/auth",
      "!!conformance/webhooks",
      "!!conformance/migrations",
      "!!conformance/cli",
      "!!conformance/typegen",
      "!!.changeset/*.md",
      "!!apps/docs/src/content",
      "!!**/routeTree.gen.ts",
      "!!deploy/helm/*/templates",
      "!!**/.next",
      "!!**/next-env.d.ts",
      "!!.canopy"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
