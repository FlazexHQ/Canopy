    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "canopy.js": "0.0.0",
    "@canopy/policy": "workspace:*",
    "@canopy/server": "workspace:*",
    "esbuild": "0.28.2",
    "mongodb": "7.7.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
