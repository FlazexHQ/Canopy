{
  "name": "@canopy/example-todo-react",
  "version": "0.0.0",
  "private": true,
  "description": "An optimistic, offline capable React todo list on Canopy: REST, realtime with fallbacks, and an IndexedDB offline queue in one Node server.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc -b . web",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "canopy.js": "0.0.0",
    "@canopy/policy": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/rest": "workspace:*",
    "@canopy/schema": "workspace:*",
    "esbuild": "0.28.2",
    "jose": "6.2.14",
    "mongodb": "7.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@canopy/cli": "workspace:*",
    "@canopy/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
