# The helpdesk app. Copy to .env and adjust.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/helpdesk?replicaSet=rs0

# Auth0. Leave AUTH0_DOMAIN empty to use the built in development issuer instead.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://helpdesk.example/api
AUTH0_CLIENT_ID=
ROLES_CLAIM=https://helpdesk.example/roles

# Where browsers reach the canopy-realtime sidecar, and the key it accepts.
CANOPY_URL=http://localhost:8080
CANOPY_PUBLISHABLE_KEY=pk_helpdesk_local
