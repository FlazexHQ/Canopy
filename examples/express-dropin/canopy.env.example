# The canopy-realtime sidecar. Copy to canopy.env and adjust.
MONGODB_URI=mongodb://localhost:27017/helpdesk?replicaSet=rs0
CANOPY_POLICIES=./canopy/policies
CANOPY_PUBLISHABLE_KEYS=pk_helpdesk_local
PORT=8080
METRICS_PORT=9464

# The same identity provider as the app. With the development issuer, the app publishes the JWKS.
# For Auth0 use https://YOUR_TENANT.auth0.com/.well-known/jwks.json and https://YOUR_TENANT.auth0.com/
CANOPY_JWT_JWKS_URL=http://localhost:3000/.well-known/jwks.json
CANOPY_JWT_ISSUER=http://localhost:3000/
CANOPY_JWT_AUDIENCE=https://helpdesk.example/api
CANOPY_JWT_ROLES_CLAIM=https://helpdesk.example/roles
