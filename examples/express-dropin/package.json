{
  "name": "@canopy/example-express-dropin",
  "version": "0.0.0",
  "private": true,
  "description": "An Express, Mongoose and Auth0 helpdesk turned into a live dashboard by the canopy-realtime sidecar.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "sidecar": "node --env-file=canopy.env node_modules/@canopy/realtime/dist/bin/canopy-realtime.js",
    "policies:lint": "canopy policies lint --dir canopy/policies",
    "policies:test": "canopy policies test --dir canopy/policies",
    "doctor": "node --env-file=canopy.env node_modules/@canopy/cli/dist/cli.js doctor --dir canopy/policies",
    "typecheck": "tsc -b . web",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth0/auth0-react": "2.29.0",
    "canopy.js": "0.0.0",
    "@canopy/policy": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "express-oauth2-jwt-bearer": "1.11.0",
    "jose": "6.2.14",
    "mongoose": "9.11.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@canopy/cli": "workspace:*",
    "@canopy/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mongodb": "7.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
