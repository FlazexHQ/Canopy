{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.server.json",
  "compilerOptions": {
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "../node_modules/.cache/server-types",
    "tsBuildInfoFile": "../node_modules/.cache/server-types/.tsbuildinfo"
  },
  "include": [".", "../e2e", "../next.config.ts", "../playwright.config.ts"],
  "references": [{ "path": "../../../packages/policy" }, { "path": "../../../packages/server" }]
}
