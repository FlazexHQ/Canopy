{
  "name": "@canopy/example-auth-notes",
  "version": "0.0.0",
  "private": true,
  "description": "Private notes with Canopy's built in auth: sign up and sign in with email and password, then a live query of your own notes.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc -b . web",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@canopy/client": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/schema": "workspace:*",
    "@canopy/server": "workspace:*",
    "esbuild": "0.28.2",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
