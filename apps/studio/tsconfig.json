{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.server.json",
  "compilerOptions": {
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "node_modules/.cache/node-types",
    "tsBuildInfoFile": "node_modules/.cache/node-types/.tsbuildinfo"
  },
  "include": ["vite.config.ts", "csp-styles.ts", "playwright.config.ts", "e2e", "dev"],
  "references": [{ "path": "src" }, { "path": "../../packages/studio" }]
}
