{
  "name": "@canopy/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 bindings for the Canopy client: createQuery returns a rune friendly reactive object that is also a store.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/client": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.7.0"
  },
  "devDependencies": {
    "@canopy/schema": "workspace:*",
    "@canopy/testing": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
