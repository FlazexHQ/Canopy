{
  "name": "@canopy/client",
  "version": "0.0.0",
  "description": "The Canopy client SDK: a document cache with live queries, reconnection, resume and resync over canopy.v1.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fallback": {
      "types": "./dist/fallback.d.ts",
      "@canopy/source": "./src/fallback.ts",
      "default": "./dist/fallback.js"
    },
    "./rest-polling": {
      "types": "./dist/rest-polling.d.ts",
      "@canopy/source": "./src/rest-polling.ts",
      "default": "./dist/rest-polling.js"
    },
    "./persist": {
      "types": "./dist/persist.d.ts",
      "@canopy/source": "./src/persist.ts",
      "default": "./dist/persist.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "@canopy/source": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/matcher": "workspace:*",
    "@canopy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@canopy/policy": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/rest": "workspace:*",
    "@canopy/server": "workspace:*",
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "fake-indexeddb": "catalog:",
    "fast-check": "catalog:",
    "jose": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
