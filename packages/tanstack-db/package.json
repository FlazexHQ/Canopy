{
  "name": "@canopy/tanstack-db",
  "version": "0.0.0",
  "description": "Canopy collections as TanStack DB collections: synced from realtime live queries, written through Canopy mutations.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/client": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/db": "^1.0.0-rc.1"
  },
  "devDependencies": {
    "@tanstack/db": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
