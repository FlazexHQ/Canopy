{
  "name": "@canopy/control",
  "version": "0.0.0",
  "description": "The Canopy control service for auth, administration, policy publishing, migrations and webhooks.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "canopy-control": "./dist/bin/canopy-control.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/config": "workspace:*",
    "@canopy/node-http": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/server": "workspace:*"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
