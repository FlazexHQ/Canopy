{
  "name": "@canopy/server",
  "version": "0.0.0",
  "description": "The Canopy server: REST, realtime, auth and policies composed from one config with createCanopy.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "canopy-server": "./dist/bin/canopy-server.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/auth": "workspace:*",
    "@canopy/auth-builtin": "workspace:*",
    "@canopy/config": "workspace:*",
    "@canopy/graphql": "workspace:*",
    "@canopy/node-http": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/protocol": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/rest": "workspace:*",
    "@canopy/studio": "workspace:*",
    "mongodb": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "jose": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:"
  }
}
