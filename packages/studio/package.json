{
  "name": "@canopy/studio",
  "version": "0.0.0",
  "description": "Canopy Studio as static assets, with a fetch style handler that serves them at /studio under a strict Content Security Policy.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "canopy-studio": "./dist/bin/canopy-studio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "app",
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/node-http": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
