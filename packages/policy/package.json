{
  "name": "@canopy/policy",
  "version": "0.0.0",
  "description": "Document Level Security: the policy DSL, stored format, compiler, field rules, explain, lint and the policy test runner.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "@canopy/source": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "mutation": "node ../../node_modules/@stryker-mutator/core/bin/stryker.js run",
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/matcher": "workspace:*",
    "@canopy/protocol": "workspace:*",
    "@canopy/query": "workspace:*"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "canopy.js": "0.0.0",
    "fast-check": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
