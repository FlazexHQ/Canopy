{
  "name": "@canopy/matcher",
  "version": "0.0.0",
  "description": "BSON comparison order, in-process filter matching, sort, projection and update operators, verified against MongoDB.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "bson": "catalog:",
    "fast-check": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
