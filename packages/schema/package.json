{
  "name": "@canopy/schema",
  "version": "0.0.0",
  "description": "Collection schemas for Canopy: inference from sampled documents, MongoDB $jsonSchema validators, field rules per role and TypeScript generation.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define/index.d.ts",
      "@canopy/source": "./src/define/index.ts",
      "default": "./dist/define/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/matcher": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/protocol": "workspace:*"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "canopy.js": "0.0.0",
    "fast-check": "catalog:",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
