{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.server.json",
  "compilerOptions": {
    "rootDir": "test",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "node_modules/.cache/test-types",
    "tsBuildInfoFile": "node_modules/.cache/test-types/.tsbuildinfo"
  },
  "include": ["test"],
  "exclude": ["test/migration"],
  "references": [
    { "path": "../schema" },
    { "path": "../query" },
    { "path": "../testing" },
    { "path": "../realtime" },
    { "path": "../rest" },
    { "path": "../server" }
  ]
}
