{
  "name": "@canopy/cli",
  "version": "0.0.0",
  "description": "Launcher for the native Canopy command line.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "canopy": "./dist/launcher.mjs"
  },
  "files": [
    "dist/launcher.mjs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run",
    "build:launcher": "bun build-launcher.ts"
  },
  "devDependencies": {
    "@canopy/auth": "workspace:*",
    "@canopy/config": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@canopy/protocol": "workspace:*",
    "@canopy/query": "workspace:*",
    "@canopy/realtime": "workspace:*",
    "@canopy/rest": "workspace:*",
    "@canopy/schema": "workspace:*",
    "@canopy/server": "workspace:*",
    "mongodb": "catalog:",
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "canopy.js": "0.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "preferUnplugged": true
}
