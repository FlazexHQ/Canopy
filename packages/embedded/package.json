{
  "name": "@canopy/embedded",
  "version": "0.0.0",
  "description": "Canopy's TypeScript data routes for embedding in Node applications.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@canopy/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b test",
    "test": "vitest run"
  },
  "dependencies": {
    "@canopy/config": "workspace:*",
    "@canopy/node-http": "workspace:*",
    "@canopy/server": "workspace:*"
  },
  "devDependencies": {
    "@canopy/testing": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@canopy/policy": "workspace:*",
    "mongodb": "catalog:"
  }
}
