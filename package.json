{
  "name": "canopy-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@astrojs/starlight": "0.42.9",
      "@biomejs/biome": "2.6.4",
      "@changesets/cli": "3.0.3",
      "@codemirror/autocomplete": "6.20.4",
      "@codemirror/commands": "6.11.1",
      "@codemirror/lang-json": "6.0.2",
      "@codemirror/language": "6.13.1",
      "@codemirror/lint": "6.9.7",
      "@codemirror/search": "6.7.2",
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.15",
      "@lezer/highlight": "1.2.5",
      "@opentelemetry/api": "1.9.1",
      "@opentelemetry/context-async-hooks": "2.12.0",
      "@opentelemetry/core": "2.12.0",
      "@opentelemetry/sdk-trace-base": "2.12.0",
      "@playwright/test": "1.64.1",
      "@scalar/api-reference": "1.76.2",
      "@seriousme/openapi-schema-validator": "2.11.0",
      "@sveltejs/vite-plugin-svelte": "7.3.1",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/db": "1.0.0-rc.1.3",
      "@tanstack/react-query": "5.105.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/router-plugin": "1.168.48",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@testing-library/user-event": "14.6.8",
      "@types/bun": "1.4.4",
      "@types/node": "24.19.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/ws": "8.18.2",
      "@vitejs/plugin-react": "6.1.2",
      "@vitest/coverage-v8": "5.0.5",
      "astro": "7.4.5",
      "bson": "7.3.3",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "cm6-graphql": "1.0.0",
      "fake-indexeddb": "6.2.7",
      "fast-check": "4.10.2",
      "graphql": "16.15.0",
      "graphql-ws": "6.4.1",
      "graphql-yoga": "6.0.1",
      "happy-dom": "21.0.4",
      "hash-wasm": "4.12.0",
      "jose": "6.2.14",
      "knip": "6.42.1",
      "lefthook": "2.2.2",
      "lucide-react": "1.64.0",
      "mongodb": "7.7.0",
      "radix-ui": "1.8.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "solid-js": "1.9.18",
      "style-mod": "4.1.4",
      "svelte": "5.57.3",
      "tailwind-merge": "3.7.0",
      "tailwindcss": "4.3.3",
      "turbo": "2.11.10",
      "typescript": "6.0.3",
      "uplot": "1.6.32",
      "vite": "8.3.5",
      "vitest": "5.0.5",
      "vue": "3.5.44",
      "ws": "8.22.0",
      "yaml": "2.9.1"
    }
  },
  "trustedDependencies": [],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:exports": "knip --no-progress",
    "lint:docs": "bun apps/docs/scripts/api-reference.ts --check",
    "lint:snippets": "bun packages/testing/scripts/readmes.ts --check && bun packages/testing/scripts/snippets.ts",
    "readmes": "bun packages/testing/scripts/readmes.ts",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run lint:exports && bun run lint:docs && bun run lint:snippets && bun run test:all",
    "db:up": "docker compose -f deploy/compose/dev.yaml up -d --wait",
    "db:down": "docker compose -f deploy/compose/dev.yaml down",
    "dev": "bun --conditions=@canopy/source packages/cli/src/cli.ts dev --config deploy/dev/canopy.config.ts",
    "db:smoke": "docker compose -f deploy/compose/dev.yaml exec -T mongo mongosh --quiet --file /canopy/mongo-smoke.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@canopy/config": "workspace:*",
    "@canopy/policy": "workspace:*",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "reflect-metadata": "0.2.2",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
